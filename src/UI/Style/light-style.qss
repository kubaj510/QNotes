* {
  font-family: "Inter", "Segoe UI", system-ui, sans-serif;
  outline: 0;
}

QWidget {
  color: #1C1C22;
}

QToolTip {
  background-color: #FFFFFF;
  color: #1C1C22;
  border: 1px solid #C6C6D2;
  border-radius: 6px;
  padding: 5px 9px;
  font-size: 12px;
}

QMainWindow {
  background-color: #F4F4F6;
}

QWidget#centralwidget {
  background-color: #ECECF0;
}

QWidget#centralwidget QPushButton#menuButton {
  margin-top: 4px;
}

QTextEdit#contentEditor {
  background-color: #FFFFFF;
  color: #1C1C22;
  border: 1px solid #D8D8E6;
  border-radius: 12px;
  padding: 22px 24px;
  font-size: 14px;
  line-height: 1.5;
  selection-background-color: #C9C9F2;
  selection-color: #1A1A24;
}

QTextEdit#contentEditor:focus {
  background-color: #FFFFFF;
  border: 1px solid #A3A3C8;
}

QTextEdit#contentEditor:disabled {
  background-color: #ECECF0;
  color: #8A8A96;
  border: 1px solid #DEDEE6;
}

QMenuBar {
  background-color: #F4F4F6;
  color: #55555F;
  font-size: 12px;
  padding: 4px 8px;
  border: none;
  spacing: 2px;
}

QMenuBar::item {
  background: transparent;
  padding: 5px 12px;
  border-radius: 7px;
}

QMenuBar::item:selected {
  background-color: #E2E2E9;
  color: #1C1C22;
}

QMenuBar::item:pressed {
  background-color: #D5D5DD;
  color: #1C1C22;
}

QMenu {
  background-color: #FFFFFF;
  color: #1C1C22;
  border: 1px solid #D5D5DD;
  border-radius: 12px;
  padding: 6px;
  font-size: 13px;
  icon-size: 16px;
}

QMenu::item {
  background: transparent;
  padding: 7px 28px 7px 16px;
  margin: 1px 2px;
  border-radius: 7px;
}

QMenu::item:selected {
  background-color: #5B5BD6;
  color: #FFFFFF;
}

QMenu::item:disabled {
  color: #8A8A96;
  background: transparent;
}

QMenu::separator {
  height: 1px;
  background-color: #E4E4EA;
  margin: 6px 12px;
}

QMenu::indicator {
  width: 16px;
  height: 16px;
  left: 6px;
}

QMenu::icon {
  left: 8px;
}

QStatusBar {
  background-color: #F4F4F6;
  color: #8A8A96;
  font-size: 11px;
  border-top: 1px solid #DEDEE6;
  padding: 2px 12px;
}

QStatusBar::item {
  border: none;
}

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 4px 2px 4px 2px;
  border: none;
}

QScrollBar::handle:vertical {
  background: #C2C2CC;
  min-height: 36px;
  border-radius: 5px;
  border: none;
}

QScrollBar::handle:vertical:hover {
  background: #A9A9B5;
}

QScrollBar::handle:vertical:pressed {
  background: #5B5BD6;
}

QScrollBar:horizontal {
  background: transparent;
  height: 10px;
  margin: 2px 4px 2px 4px;
  border: none;
}

QScrollBar::handle:horizontal {
  background: #C2C2CC;
  min-width: 36px;
  border-radius: 5px;
  border: none;
}

QScrollBar::handle:horizontal:hover {
  background: #A9A9B5;
}

QScrollBar::handle:horizontal:pressed {
  background: #5B5BD6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  height: 0px;
  width: 0px;
  background: none;
  border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
  background: none;
}

QDialog,
QWidget#Help,
QMessageBox,
QFileDialog {
  background-color: #F4F4F6;
  color: #1C1C22;
}

QDialog {
  border: 1px solid #DEDEE6;
}

QWidget#Help QTextBrowser#content {
  background-color: #FFFFFF;
  color: #33333C;
  border: 1px solid #D8D8E6;
  border-radius: 10px;
  padding: 14px 16px;
  selection-background-color: #C9C9F2;
  selection-color: #1A1A24;
}

QWidget#Help QTextBrowser#content:focus {
  border: 1px solid #A3A3C8;
}

QMessageBox QLabel {
  color: #1C1C22;
  background: transparent;
  font-size: 13px;
}

QMessageBox QLabel#qt_msgbox_informativelabel,
QMessageBox QLabel#qt_msgbox_detailedtext {
  color: #55555F;
}

QFileDialog QListView,
QFileDialog QTreeView {
  background-color: #FFFFFF;
  color: #1C1C22;
  border: 1px solid #D8D8E6;
  border-radius: 10px;
  padding: 6px;
  selection-background-color: #5B5BD6;
  selection-color: #FFFFFF;
  alternate-background-color: #F4F4F8;
  outline: 0;
}

QFileDialog QListView::item:selected,
QFileDialog QTreeView::item:selected {
  background-color: #5B5BD6;
  color: #FFFFFF;
  border-radius: 6px;
}

QFileDialog QListView::item:hover,
QFileDialog QTreeView::item:hover {
  background-color: #ECECF4;
}

QFileDialog QHeaderView::section {
  background-color: #FFFFFF;
  color: #55555F;
  border: none;
  border-bottom: 1px solid #DEDEE6;
  padding: 6px 8px;
  font-size: 12px;
}

QFileDialog QSplitter::handle {
  background: #DEDEE6;
}

QFileDialog QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 7px;
  padding: 5px;
  color: #55555F;
}

QFileDialog QToolButton:hover {
  background-color: #E9E9EE;
  border-color: #C6C6D2;
  color: #1C1C22;
}

QFileDialog QToolButton:pressed {
  background-color: #DEDEE6;
}

QGroupBox {
  background-color: #EAEAF0;
  border: 1px solid #DBDBE3;
  border-radius: 10px;
  margin-top: 22px;
  padding-top: 12px;
  padding-left: 12px;
  padding-right: 12px;
  padding-bottom: 10px;
  color: #55555F;
  font-size: 12px;
  font-weight: 600;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 12px;
  top: 2px;
  background: transparent;
  color: #4A4A55;
  border: none;
  padding: 0px 4px;
  font-size: 14px;
  font-weight: 700;
}

QDialog#PreferencesWindow {
  background-color: #F4F4F6;
}

QDialog#PreferencesWindow QLabel {
  color: #55555F;
  font-size: 13px;
}

QDialog#PreferencesWindow QCheckBox,
QDialog#PreferencesWindow QRadioButton {
  color: #33333C;
  spacing: 10px;
  padding: 3px 0px;
}

QDialog#PreferencesWindow QComboBox,
QDialog#PreferencesWindow QSpinBox {
  min-height: 20px;
  padding: 7px 10px;
}

QDialog#PreferencesWindow QDialogButtonBox {
  margin-top: 4px;
}

QDialog#PreferencesWindow QDialogButtonBox QPushButton {
  min-width: 88px;
}

QLabel {
  color: #1C1C22;
  background: transparent;
  font-size: 13px;
}

QLabel:disabled {
  color: #8A8A96;
}

QCheckBox, QRadioButton {
  color: #33333C;
  background: transparent;
  font-size: 13px;
  spacing: 8px;
  padding: 2px 0px;
}

QCheckBox:disabled, QRadioButton:disabled {
  color: #8A8A96;
}

QCheckBox::indicator, QRadioButton::indicator {
  width: 16px;
  height: 16px;
  background-color: #FFFFFF;
  border: 1px solid #A9A9B5;
}

QCheckBox::indicator {
  border-radius: 5px;
}

QRadioButton::indicator {
  border-radius: 8px;
  width: 14px;
  height: 14px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
  border-color: #5B5BD6;
}

QCheckBox::indicator:pressed, QRadioButton::indicator:pressed {
  border-color: #6E6EE0;
  background-color: #ECECF4;
}

QCheckBox::indicator:checked {
  background-color: #5B5BD6;
  border: 1px solid #5B5BD6;
}

QCheckBox::indicator:checked:hover {
  background-color: #6E6EE0;
  border-color: #6E6EE0;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
  background-color: #ECECF0;
  border-color: #D5D5DD;
}

QRadioButton::indicator:checked {
  background-color: #FFFFFF;
  border: 3px solid #5B5BD6;
  width: 8px;
  height: 8px;
  border-radius: 7px;
}

QRadioButton::indicator:checked:hover {
  border-color: #6E6EE0;
}

QLineEdit {
  background-color: #FFFFFF;
  color: #1C1C22;
  border: 1px solid #C6C6D2;
  border-radius: 8px;
  padding: 7px 10px;
  font-size: 13px;
  selection-background-color: #C9C9F2;
  selection-color: #1A1A24;
}

QLineEdit:hover {
  border-color: #A9A9B5;
}

QLineEdit:focus {
  background-color: #FFFFFF;
  border: 1px solid #5B5BD6;
}

QLineEdit:disabled {
  background-color: #ECECF0;
  color: #8A8A96;
  border-color: #DEDEE6;
}

QComboBox, QSpinBox {
  background-color: #FFFFFF;
  color: #1C1C22;
  border: 1px solid #C6C6D2;
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 13px;
  selection-background-color: #C9C9F2;
}

QComboBox:hover, QSpinBox:hover {
  border-color: #A9A9B5;
  background-color: #FAFAFC;
}

QComboBox:focus, QSpinBox:focus {
  background-color: #FFFFFF;
  border: 1px solid #5B5BD6;
}

QComboBox:disabled, QSpinBox:disabled {
  background-color: #ECECF0;
  color: #8A8A96;
  border-color: #DEDEE6;
}

QComboBox::drop-down {
  border: none;
  width: 28px;
  background: transparent;
}

QComboBox::down-arrow {
  width: 10px;
  height: 10px;
}

QComboBox QAbstractItemView,
QSpinBox QAbstractItemView {
  background-color: #FFFFFF;
  color: #1C1C22;
  border: 1px solid #C6C6D2;
  border-radius: 0px;
  padding: 4px;
  selection-background-color: #5B5BD6;
  selection-color: #FFFFFF;
  outline: 0;
}

QAbstractItemView::item {
  padding: 6px 10px;
  border-radius: 6px;
}

QSpinBox::up-button, QSpinBox::down-button {
  background: transparent;
  border: none;
  width: 22px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
  background-color: #E9E9EE;
  border-radius: 5px;
}

QSpinBox::up-button:pressed, QSpinBox::down-button:pressed {
  background-color: #DEDEE6;
}

QSpinBox::up-arrow, QSpinBox::down-arrow {
  width: 9px;
  height: 9px;
}

QComboBox QAbstractItemView QListView {
  border: none;
}

QPushButton {
  background-color: #E9E9EE;
  color: #1C1C22;
  border: 1px solid #C6C6D2;
  border-radius: 8px;
  padding: 7px 18px;
  font-size: 13px;
  font-weight: 600;
}

QPushButton:hover {
  background-color: #DEDEE6;
  border-color: #A9A9B5;
  color: #000000;
}

QPushButton:pressed {
  background-color: #D5D5DD;
  border-color: #C6C6D2;
}

QPushButton:focus {
  border: 1px solid #5B5BD6;
}

QPushButton:disabled {
  background-color: #ECECF0;
  color: #8A8A96;
  border-color: #DEDEE6;
}

QPushButton:default {
  background-color: #5B5BD6;
  border-color: #5B5BD6;
  color: #FFFFFF;
}

QPushButton:default:hover {
  background-color: #6E6EE0;
  border-color: #6E6EE0;
}

QPushButton:default:pressed {
  background-color: #4A4AB8;
  border-color: #4A4AB8;
}

QDialogButtonBox {
  background: transparent;
  button-layout: 3;
}

QDialogButtonBox QPushButton {
  min-width: 84px;
  padding: 7px 16px;
}

QPushButton#okButton {
  background-color: #5B5BD6;
  border: 1px solid #5B5BD6;
  color: #FFFFFF;
  border-radius: 8px;
  padding: 7px 26px;
  font-weight: 700;
}

QPushButton#okButton:hover {
  background-color: #6E6EE0;
  border-color: #6E6EE0;
}

QPushButton#okButton:pressed {
  background-color: #4A4AB8;
  border-color: #4A4AB8;
}

QPushButton#okButton:focus {
  border: 1px solid #8E8EE8;
}

QPushButton#menuButton {
  background-color: transparent;
  color: #8A8A96;
  font-size: 15px;
  font-weight: 400;
  border: 1px solid transparent;
  border-radius: 7px;
  padding: 0px;
  margin: 0px;
  min-width: 32px;
  max-width: 32px;
  min-height: 26px;
  max-height: 26px;
}

QPushButton#menuButton:hover {
  background-color: #E2E2E9;
  border-color: #E2E2E9;
  color: #1C1C22;
}

QPushButton#menuButton:pressed {
  background-color: #DEDEE6;
  border-color: #DEDEE6;
  color: #55555F;
}

QPushButton#menuButton:focus {
  border: 1px solid #A9A9B5;
  color: #1C1C22;
}

QTextBrowser {
  selection-background-color: #C9C9F2;
  selection-color: #1A1A24;
}
